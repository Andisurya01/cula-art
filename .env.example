# Salin ke .env lalu ganti nilainya. .env tidak di-commit.

# PostgreSQL 18 lokal: role `galeri`, database galeri_dev (aplikasi) dan galeri_test (test integrasi).
DATABASE_URL="postgresql://galeri:GANTI_PASSWORD@localhost:5432/galeri_dev?schema=public"
DATABASE_URL_TEST="postgresql://galeri:GANTI_PASSWORD@localhost:5432/galeri_test?schema=public"

# Folder file unggahan. Path relatif mengikuti folder tempat server dijalankan (cwd); pakai path absolut
# jika server dijalankan dari folder lain (mis. preview). Di server: /srv/galeri/uploads (di luar folder rilis).
UPLOAD_DIR="./uploads"

# URL publik tanpa garis miring di akhir (sitemap, Open Graph, tautan WhatsApp).
SITE_URL="http://localhost:3000"

# Asisten AI (Fase 3). Kunci dari Anthropic Console (console.anthropic.com → API keys); isi sendiri, jangan
# di-commit. Pasang juga batas pengeluaran bulanan di Console. Kosong = tombol Bantu AI menampilkan error.
ANTHROPIC_API_KEY=""

# Mode uji: jawaban contoh tanpa memanggil API (biaya 0), untuk pengembangan dan uji manual.
# Jangan pernah aktif di produksi.
# AI_MOCK=1
