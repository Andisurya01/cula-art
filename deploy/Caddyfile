# /etc/caddy/Caddyfile — ganti namaanda.com dengan domain sebenarnya.
# Caddy mengurus sertifikat HTTPS (Let's Encrypt) otomatis dan memperbarui sendiri.

namaanda.com {
	encode zstd gzip

	header {
		# HSTS hanya di sini (bukan di Next.js), supaya development lokal lewat http tetap jalan.
		# Tambahkan "; preload" hanya jika yakin semua subdomain selamanya HTTPS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Unggahan foto maks. 15 MB + overhead multipart.
	request_body {
		max_size 20MB
	}

	# Aplikasi hanya mendengar di 127.0.0.1; Caddy menulis ulang X-Forwarded-For dengan IP klien
	# (dipakai pembatasan login per IP).
	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/galeri.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

www.namaanda.com {
	redir https://namaanda.com{uri} permanent
}
